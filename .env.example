NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Web Push: generate once with `npx web-push generate-vapid-keys`, reuse forever.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Email: create a free account at resend.com and paste your API key.
RESEND_API_KEY=
RESEND_FROM_EMAIL=The Padellers <onboarding@resend.dev>

# Native push (APNs): create an "APNs Key" at developer.apple.com > Certificates,
# IDs & Profiles > Keys. The .p8 can only be downloaded once — store it securely.
APNS_KEY_ID=
APNS_TEAM_ID=
# .p8 file content, PEM newlines replaced with literal \n (must fit one env var line)
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.clubtermin.app
# "development" only while testing against an Xcode Debug build on a device;
# TestFlight/App Store builds always need this unset (defaults to production).
APNS_ENV=
